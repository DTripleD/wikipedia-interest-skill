# Copy to .env (gitignored) and fill in. Variables already set in the shell take precedence.

# Contact sent in the User-Agent, as the Wikimedia User-Agent policy requires.
# Use a real email or a full URL; otherwise Wikimedia may limit you to 10 requests/minute.
WIKI_SKILL_CONTACT=you@example.org

# Cache directory. Unset: .cache/ in the project root. Relative paths are resolved
# against the project root. An empty value disables caching.
# WIKI_SKILL_CACHE_DIR=.cache
